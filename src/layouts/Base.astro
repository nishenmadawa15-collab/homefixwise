---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">HomeFixWise</a>
    <nav aria-label="Primary navigation">
      <a href="/#hvac">HVAC</a><a href="/#plumbing">Plumbing</a><a href="/#basement">Basement</a><a href="/#cost">Cost Guides</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer>
    <p>HomeFixWise provides educational home-repair information for U.S. and Canadian homeowners. Safety-critical work should be handled by a qualified professional.</p>
    <p><a href="/about/">About</a> · <a href="/editorial-policy/">Editorial Policy</a> · <a href="/privacy/">Privacy</a></p>
  </footer>
</body>
</html>
