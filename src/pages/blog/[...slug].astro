---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} | HomeFixWise`} description={post.data.description}>
  <article class="article">
    <span class="pill">{post.data.category}</span>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    <div class="notice"><strong>Safety:</strong> Stop and contact a qualified professional for gas, combustion, live electrical, structural, or other safety-critical work.</div>
    <Content />
  </article>
</Base>
