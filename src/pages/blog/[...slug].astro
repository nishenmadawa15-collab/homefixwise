---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      slug: post.id.replace(/\.(md|mdx)$/, "")
    },
    props: {
      post
    }
  }));
}

const { post } = Astro.props;

const { Content } = await render(post);

const title = `${post.data.title} | HomeFixWise`;

const description =
  post.data.description ??
  "Practical home repair troubleshooting and repair cost guidance for U.S. and Canadian homeowners.";
---

<Base {title} {description}>
  <article class="article">

    <p class="eyebrow">
      {post.data.category ?? "Home Repair Guide"}
    </p>

    <h1>{post.data.title}</h1>

    {
      post.data.description && (
        <p class="lede">
          {post.data.description}
        </p>
      )
    }

    <div class="notice">
      <strong>Safety:</strong>
      Stop and contact a qualified professional for gas, combustion,
      live electrical, structural, or other safety-critical work.
    </div>

    <Content />

    <div class="ad-slot" aria-label="Advertisement placeholder">
      Reserved ad slot — enable only after AdSense approval
    </div>

  </article>
</Base>