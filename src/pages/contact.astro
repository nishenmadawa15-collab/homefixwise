---
import Base from "../layouts/Base.astro";

const title = "Contact HomeFixWise";
const description =
  "Contact HomeFixWise with corrections, questions, feedback, or editorial inquiries.";
---

<Base {title} {description}>
  <section class="page-shell">
    <p class="eyebrow">CONTACT</p>

    <h1>Contact HomeFixWise</h1>

    <p>
      We welcome feedback, correction requests, content suggestions, and
      editorial questions.
    </p>

    <h2>Email</h2>

    <p>
      Replace the email below with your official site email before launch.
    </p>

    <p>
      <strong>Email:</strong>
      <a href="mailto:hello@homefixwise.com">hello@homefixwise.com</a>
    </p>

    <h2>Corrections</h2>

    <p>
      If you believe an article contains inaccurate or outdated information,
      please include the article URL and a short explanation of the issue.
    </p>

    <h2>Professional advice</h2>

    <p>
      HomeFixWise cannot diagnose individual homes or provide emergency repair
      instructions. For urgent electrical, gas, fire, flooding, structural, or
      carbon-monoxide concerns, contact an appropriate local professional or
      emergency service.
    </p>
  </section>
</Base>