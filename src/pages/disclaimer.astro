---
import Base from "../layouts/Base.astro";

const title = "Disclaimer | HomeFixWise";
const description =
  "Important educational, safety, cost, and professional-service disclaimers for HomeFixWise.";
---

<Base {title} {description}>
  <section class="page-shell">
    <p class="eyebrow">DISCLAIMER</p>

    <h1>Disclaimer</h1>

    <p>
      HomeFixWise provides general educational information only.
    </p>

    <h2>Not professional advice</h2>

    <p>
      Content on this website is not a substitute for inspection, diagnosis,
      advice, or work performed by a licensed or qualified professional.
    </p>

    <h2>Safety</h2>

    <p>
      Home repair can involve electricity, gas, fire, pressure, structural
      systems, hazardous materials, and other risks. Stop and seek professional
      help whenever a task is outside your experience or presents a safety
      concern.
    </p>

    <h2>Cost estimates</h2>

    <p>
      Prices and cost ranges are informational estimates. Actual costs can vary
      by region, contractor, labor rates, materials, permits, equipment, home
      condition, and project complexity.
    </p>

    <h2>No guarantee</h2>

    <p>
      We make reasonable efforts to publish useful information but cannot
      guarantee that every article is complete, current, or applicable to every
      property or situation.
    </p>
  </section>
</Base>